    def update_executive_summary(filter_values, filter_selections):

        print("=" * 80)
        print("[EXEC SUMMARY] Filter changed")
        print("[EXEC SUMMARY] Filter values:", filter_values)
        print("[EXEC SUMMARY] Filter selections:", filter_selections)
        print("=" * 80)

        try:
            # ---------------------------------------------------------
            # Load original dataframe
            # ---------------------------------------------------------

            if not get_cached_df:
                raise PreventUpdate

            df = get_cached_df()

            if df is None or df.empty:
                return html.Div(
                    "No data available for executive summary.",
                    style={
                        'padding': '20px',
                        'color': '#DC2626'
                    }
                )

            filtered_df = df.copy()

            # ---------------------------------------------------------
            # Apply dashboard filters
            # Same filtering logic used by KPI/charts
            # ---------------------------------------------------------

            if (
                isinstance(filter_selections, list)
                and isinstance(filter_values, list)
            ):
                for filter_sel, filter_value in zip(
                    filter_selections,
                    filter_values
                ):

                    if not isinstance(filter_sel, dict):
                        continue

                    col = filter_sel.get('column', '')

                    if not col or col not in filtered_df.columns:
                        continue

                    # Multi-select
                    if isinstance(filter_value, list):

                        if not filter_value or "All" in filter_value:
                            continue

                        filtered_df = filtered_df[
                            filtered_df[col].astype(str).isin(
                                [str(v) for v in filter_value]
                            )
                        ]

                    # Single-select
                    else:

                        if filter_value and filter_value != "All":
                            filtered_df = filtered_df[
                                filtered_df[col].astype(str)
                                == str(filter_value)
                            ]

            # ---------------------------------------------------------
            # Find important business columns
            # ---------------------------------------------------------

            invoice_col = _find_existing_column(
                filtered_df,
                [
                    "Invoice Amount",
                    "InvoiceAmount",
                    "Invoice Amt"
                ]
            )

            balance_col = _find_existing_column(
                filtered_df,
                [
                    "Balance Amount",
                    "BalanceAmount",
                    "Balance Amt"
                ]
            )

            collection_col = _find_existing_column(
                filtered_df,
                [
                    "Balance Collection Amount",
                    "BalanceCollectionAmount",
                    "Collection Amount"
                ]
            )

            due_days_col = _find_existing_column(
                filtered_df,
                [
                    "Due Days",
                    "DueDays"
                ]
            )

            invoice_no_col = _find_existing_column(
                filtered_df,
                [
                    "Invoice No",
                    "Invoice Number",
                    "InvoiceNo"
                ]
            )

            # ---------------------------------------------------------
