            record_count = len(filtered_df)

            total_invoice = 0
            total_balance = 0
            total_collection = 0
            avg_due_days = 0

            if invoice_col:
                invoice_values = pd.to_numeric(
                    filtered_df[invoice_col],
                    errors='coerce'
                )
                total_invoice = invoice_values.sum()

            if balance_col:
                balance_values = pd.to_numeric(
