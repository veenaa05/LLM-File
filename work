# ============================================================
# STANDARDIZE ALL DATE COLUMNS
# ============================================================

date_cols = [
    "Actual Join Date",
    "Resignation Date",
    "Last Working Date",
    "Effective Start Date",
    "Effective End Date",
    "Birth Date"
]

for col in date_cols:
    employee_master[col] = pd.to_datetime(
        employee_master[col],
        errors="coerce"
    )

print("Date columns converted successfully.")

print("\n=== DATE DTYPES ===")
for col in date_cols:
    print(f"{col:25} -> {employee_master[col].dtype}")
/////::/:/
# ============================================================
# CLEAN INVALID / PLACEHOLDER LAST WORKING DATES
# ============================================================

invalid_lwd = employee_master["Last Working Date"] < pd.Timestamp("1950-01-01")

print(
    "Invalid/placeholder Last Working Date records:",
    invalid_lwd.sum()
)

employee_master.loc[
    invalid_lwd,
    "Last Working Date"
] = pd.NaT



/////:/
# ============================================================
# EFFECTIVE DATE ANALYSIS
# ============================================================

print("=== EFFECTIVE DATE AVAILABILITY ===")

for col in [
    "Effective Start Date",
    "Effective End Date"
]:
    
    print(
        f"{col:25} "
        f"Available: {employee_master[col].notna().sum():6} | "
        f"Missing: {employee_master[col].isna().sum():6} | "
        f"Missing %: {employee_master[col].isna().mean()*100:.2f}%"
    )

print("\n=== EFFECTIVE DATE RANGE ===")

for col in [
    "Effective Start Date",
    "Effective End Date"
]:
    
    print(
        f"{col:25} "
        f"Min: {employee_master[col].min()} | "
        f"Max: {employee_master[col].max()}"
    )

/////
# ============================================================
# DUPLICATE EMPLOYEE ANALYSIS
# ============================================================

duplicate_mask = employee_master["Employee Code"].duplicated(
    keep=False
)

duplicate_employees = employee_master[
    duplicate_mask
].copy()

print(
    "Rows belonging to duplicate Employee Codes:",
    len(duplicate_employees)
)

print(
    "Number of duplicate Employee Codes:",
    duplicate_employees["Employee Code"].nunique()
)

print("\n=== DUPLICATE RECORD SUMMARY ===")

duplicate_summary = (
    duplicate_employees
    .groupby("Employee Code")
    .agg(
        Record_Count=("Employee Code", "size"),
        Employee_Name=("Employee Name", "first"),
        Actual_Join=("Actual Join Date", "min"),
        First_Effective_Start=("Effective Start Date", "min"),
        Last_Effective_Start=("Effective Start Date", "max"),
        First_Resignation=("Resignation Date", "min"),
        Last_Resignation=("Resignation Date", "max"),
        First_Effective_End=("Effective End Date", "min"),
        Last_Effective_End=("Effective End Date", "max")
    )
    .reset_index()
)

display(duplicate_summary)


