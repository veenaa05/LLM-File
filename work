# GENDER VALIDATION
# ============================================================

monthly_diversity["Gender Total"] = (
    monthly_diversity["Male"]
    + monthly_diversity["Female"]
    + monthly_diversity["Other Gender"]
)

gender_check = monthly_diversity[
    [
        "ds",
        "Total Employees",
        "Male",
        "Female",
        "Other Gender",
        "Gender Total"
    ]
].copy()

gender_check["Difference"] = (
    gender_check["Total Employees"]
    - gender_check["Gender Total"]
)

display(
    gender_check.tail(12)
)


///////
# ============================================================
# AGE GROUP VALIDATION
# ============================================================

monthly_diversity["Age Total"] = (
    monthly_diversity["Age Below 25"]
    + monthly_diversity["Age 25-35"]
    + monthly_diversity["Age 35-50"]
    + monthly_diversity["Age Above 50"]
)

age_check = monthly_diversity[
    [
        "ds",
        "Total Employees",
        "Age Below 25",
        "Age 25-35",
        "Age 35-50",
        "Age Above 50",
        "Age Total"
    ]
].copy()

age_check["Difference"] = (
    age_check["Total Employees"]
    - age_check["Age Total"]
)

display(
    age_check.tail(12)
)


# ============================================================
# RELIGION VALIDATION
# ============================================================

religion_check = monthly_diversity[
    [
        "ds",
        "Total Employees",
        "Hinduism",
        "Muslim",
        "Christian",
        "Other Religion"
    ]
].copy()

religion_check["Religion Recorded"] = (
    religion_check["Hinduism"]
    + religion_check["Muslim"]
    + religion_check["Christian"]
    + religion_check["Other Religion"]
)

religion_check["Religion Missing"] = (
    religion_check["Total Employees"]
    - religion_check["Religion Recorded"]
)

display(
    religion_check.tail(12)
)


