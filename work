                                }
                            )
                        )

                # ========================================================
                # BUILD CHART RECOMMENDATIONS
                # ========================================================
                chart_components = []

                for item in charts:
                    if isinstance(item, dict):

                        chart_type = item.get("type", "")
                        x_column = item.get("x", "")
                        y_column = item.get("y")
                        title = item.get("title", "")

                        chart_text = title

