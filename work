def create_kpi_item(
    kpi_id: str,
    column: str,
    aggregation: str = 'sum',
    label: str = None,
    z_index: int = 1,
    dtype: str = 'numeric'
) -> html.Div:
    """Create a KPI configuration card"""

    if dtype == 'numeric':
        aggregation_options = [
            {'label': 'Sum', 'value': 'sum'},
            {'label': 'Average', 'value': 'mean'},
            {'label': 'Count', 'value': 'count'},
            {'label': 'Max', 'value': 'max'},
            {'label': 'Min', 'value': 'min'},
        ]
    else:
        aggregation_options = [
            {'label': 'Count', 'value': 'count'}
        ]
        aggregation = 'count'

    if label is None:
        label = f"{aggregation.capitalize()} of {column}"
