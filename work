 @app.callback(
    Output("download-dashboard-pdf", "data"),
    Input("btn-download-pdf", "n_clicks"),
    State("store-chart-export-data", "data"),
    prevent_initial_call=True
)
    def download_pdf(n_clicks, chart_export_data):

        print("=" * 80)
        print("DOWNLOAD ANALYSIS & INSIGHTS PDF CLICKED")
        print("=" * 80)

        if not chart_export_data:
            print("[PDF] No chart data available")
            raise PreventUpdate

        from datetime import datetime
        from reportlab.pdfgen import canvas
        from reportlab.lib.pagesizes import A4
        from reportlab.lib.utils import ImageReader
        import plotly.io as pio
        import io

        pdf_buffer = io.BytesIO()

        page_width, page_height = A4

        p = canvas.Canvas(
            pdf_buffer,
            pagesize=A4
        )

        # =========================================================
        # REPORT HEADER
        # =========================================================

        p.setFont("Helvetica-Bold", 22)
        p.drawString(
            45,
            page_height - 55,
            "Analysis & Insights"
        )

        p.setFont("Helvetica", 10)
        p.drawString(
            45,
            page_height - 73,
            "Interactive visualizations for deeper understanding"
        )

        p.setFont("Helvetica", 9)
        p.drawRightString(
            page_width - 45,
            page_height - 73,
            f"Generated: {datetime.now().strftime('%d-%b-%Y %H:%M')}"
        )

        # Header line
        p.line(
            45,
            page_height - 88,
            page_width - 45,
            page_height - 88
        )

        y = page_height - 120

        # =========================================================
        # CHARTS
        # =========================================================

        for index, chart in enumerate(chart_export_data):

            title = chart.get("title", f"Chart {index + 1}")
            figure_json = chart.get("figure")
            insight = chart.get("insight", "")

            if not figure_json:
                continue

            # -----------------------------------------------------
            # New page if required
            # -----------------------------------------------------

            if y < 250:

                p.showPage()

                p.setFont("Helvetica-Bold", 22)
                p.drawString(
                    45,
                    page_height - 55,
                    "Analysis & Insights"
                )

                p.setFont("Helvetica", 9)
                p.drawRightString(
                    page_width - 45,
                    page_height - 55,
                    f"Page {index + 2}"
                )

                y = page_height - 90

            # -----------------------------------------------------
            # Chart title
            # -----------------------------------------------------

            p.setFont("Helvetica-Bold", 13)
            clean_title = str(title).replace("_", " ").strip()
            p.drawString(
                45,
                y,
                clean_title
            )
            y -= 18
            # -----------------------------------------------------
            # Convert Plotly figure → PNG
            # -----------------------------------------------------

            try:

                png_bytes = pio.to_image(
                    figure_json,
                    format="png",
                    width=1000,
                    height=600,
                    scale=1.5
                )

                image_buffer = io.BytesIO(png_bytes)
                chart_width = page_width - 90
                chart_height = chart_width * 0.60
                p.drawImage(
                    ImageReader(image_buffer),
                    45,
                    y - chart_height,
                    width=chart_width,
                    height=chart_height,
                    preserveAspectRatio=True,
                    anchor='c'
                )

                y -= chart_height + 20
            except Exception as e:
                print(
                    f"[PDF] Could not export chart "
                    f"{index + 1}: {e}"
                )
                p.setFont("Helvetica", 9)
                p.drawString(
                    45,
                    y,
                    "Chart could not be rendered in PDF."
                )
                y -= 25
            # -----------------------------------------------------
            # Analyst Insight
            # -----------------------------------------------------

            if insight:
                if y < 100:
                    p.showPage()
                    y = page_height - 70
                p.setFont("Helvetica-Bold", 9)
                p.drawString(
                    45,
                    y,
                    "ANALYST INSIGHT"
                )
                y -= 14
                p.setFont("Helvetica", 9)
                # Wrap long insight text
                words = str(insight).split()
                line = ""
                for word in words:

                    test_line = (
                        line + " " + word
                    ).strip()

                    if p.stringWidth(
                        test_line,
                        "Helvetica",
                        9
                    ) > page_width - 100:

                        p.drawString(
                            45,
                            y,
                            line
                        )

                        y -= 12
                        line = word

                    else:

                        line = test_line

                if line:

                    p.drawString(
                        45,
                        y,
                        line
                    )

                    y -= 15

            # Space before next chart
            y -= 20

        # =========================================================
        # FINISH
        # =========================================================

        p.save()

        pdf_buffer.seek(0)

        print(
            f"[PDF] Exported {len(chart_export_data)} charts"
        )

        return dcc.send_bytes(
            pdf_buffer.getvalue(),
            "analysis_insights_report.pdf"
        )
        
