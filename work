            findings.append(
                f"The selected data contains {record_count:,} "
                f"invoice records."
            )

            if invoice_col:
                findings.append(
                    f"Total invoiced amount is approximately "
                    f"{_fmt(total_invoice)}."
                )

            if balance_col:
                findings.append(
                    f"The current balance amount is approximately "
                    f"{_fmt(total_balance)}."
                )

            if collection_col:
                findings.append(
                    f"Balance collection amount totals approximately "
                    f"{_fmt(total_collection)}."
                )

            if due_days_col and pd.notna(avg_due_days):
                findings.append(
                    f"Average due period is "
                    f"{avg_due_days:.1f} days."
                )

            # ---------------------------------------------------------
            # Data quality for the filtered records
            # ---------------------------------------------------------

            if record_count > 0:

                total_cells = (
                    filtered_df.shape[0] *
                    filtered_df.shape[1]
                )

                missing_cells = filtered_df.isna().sum().sum()

                completeness = (
                    (1 - missing_cells / total_cells) * 100
                    if total_cells
                    else 100
                )

