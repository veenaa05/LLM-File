# Keep original series for count/date fields
original_series = filtered_df[col]

# Convert only when a numeric aggregation is required
numeric_series = Formatter.coerce_numeric_series(original_series)

try:
    if agg == 'count':
        # Count actual non-empty values.
        # Do NOT count the numeric-converted series.
        value = original_series.notna().sum()

    elif agg == 'sum':
        value = numeric_series.sum()

    elif agg == 'mean':
        value = numeric_series.mean()

    elif agg == 'max':
        if pd.api.types.is_datetime64_any_dtype(original_series):
            value = original_series.max()
        else:
            value = numeric_series.max()

    elif agg == 'min':
        if pd.api.types.is_datetime64_any_dtype(original_series):
            value = original_series.min()
        else:
            value = numeric_series.min()

    else:
        value = original_series.iloc[0] if len(original_series) > 0 else None

    print(
        f"[DEBUG] KPI '{col}' ({agg}): {value} "
        f"(rows={len(filtered_df)}, "
        f"non_null={original_series.notna().sum()}, "
        f"dtype={original_series.dtype})"
    )

except Exception as calc_err:
    print(
        f"[ERROR] Failed to calculate '{col}' ({agg}): "
        f"{type(calc_err).__name__}: {str(calc_err)[:100]}"
    )
    value = None
