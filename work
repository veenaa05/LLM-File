# GENERATE DEFAULTS INDEPENDENTLY
# ============================================================

# Detect columns from CURRENT dataset
numeric_cols = [
    col for col in df.columns
    if pd.api.types.is_numeric_dtype(df[col])
]

categorical_cols = [
    col for col in df.columns
    if (
        df[col].dtype == 'object'
        or pd.api.types.is_string_dtype(df[col])
    )
    and 2 <= df[col].nunique(dropna=True) <= 50
    and not col.startswith('Unnamed')
]

# Create default KPI only if no KPI exists
if not kpi_selections and numeric_cols:
    kpi_selections = [
        {
            'column': numeric_cols[0],
            'aggregation': 'sum',
            'label': f'Total {numeric_cols[0]}'
        }
    ]

    if len(numeric_cols) > 1:
        kpi_selections.append({
            'column': numeric_cols[1],
            'aggregation': 'count',
            'label': f'Count of {numeric_cols[1]}'
        })

# Create default filters independently
if not filter_selections and categorical_cols:
    filter_selections = [
        {
            'column': categorical_cols[0],
            'filter_type': 'dropdown',
            'label': f'Filter by {categorical_cols[0]}'
        }
    ]

    if len(categorical_cols) > 1:
        filter_selections.append({
            'column': categorical_cols[1],
            'filter_type': 'dropdown',
            'label': f'Filter by {categorical_cols[1]}'
        })

print(
    "[DASHBOARD] Final KPI selections:",
    [k.get('column') for k in kpi_selections]
)

print(
    "[DASHBOARD] Final Filter selections:",
    [f.get('column') for f in filter_selections]
)

