/* ==========================================================
   CONFIG PAGE - KPI AGGREGATION DROPDOWN
   Prevent dropdown from overlapping the next KPI card
========================================================== */

.config-kpi-selection .config-kpi-dropdown,
.config-kpi-selection [id^="kpi-"] {
    overflow: visible !important;
}

.config-kpi-selection [id^="kpi-"] .Select-menu-outer {
    position: relative !important;
    z-index: 999999 !important;
    background: #ffffff !important;
}

.config-kpi-selection [id^="kpi-"] .Select-menu {
    position: relative !important;
    background: #ffffff !important;
}
