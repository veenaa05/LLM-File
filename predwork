# RECENT WORKFORCE TREND vs FORECAST VALIDATION
# ============================================================

recent_actual = diversity_forecast_df[
    ["ds", "Total Employees"]
].tail(24).copy()

recent_actual["Type"] = "Actual"

forecast_check = future_forecast[
    ["ds", "Total Employees"]
].copy()

forecast_check["Type"] = "Forecast"

validation_df = pd.concat(
    [recent_actual, forecast_check],
    ignore_index=True
)

# ------------------------------------------------------------
# RECENT ACTUAL TREND
# ------------------------------------------------------------

first_recent_actual = recent_actual.iloc[0]["Total Employees"]
last_actual = recent_actual.iloc[-1]["Total Employees"]

recent_24m_change_pct = (
    (last_actual - first_recent_actual)
    / first_recent_actual * 100
)

# Average monthly change over recent 24 months
recent_monthly_changes = (
    recent_actual["Total Employees"]
    .diff()
    .dropna()
)

avg_monthly_change = recent_monthly_changes.mean()

# ------------------------------------------------------------
# FORECAST TREND
# ------------------------------------------------------------

first_forecast = future_forecast.iloc[0]["Total Employees"]
last_forecast = future_forecast.iloc[-1]["Total Employees"]

forecast_6m_change_pct = (
    (last_forecast - last_actual)
    / last_actual * 100
)

forecast_monthly_changes = (
    future_forecast["Total Employees"]
    .diff()
    .dropna()
)

avg_forecast_monthly_change = (
    forecast_monthly_changes.mean()
)

